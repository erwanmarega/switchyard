{
  "name": "@switchyard/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env --conditions=source src/server.ts",
    "dev:hosted": "tsx watch --env-file=.env.hosted --conditions=source src/server.ts",
    "build": "npm run build -w @switchyard/plugin-sdk && tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15"
  },
  "dependencies": {
    "@switchyard/plugin-sdk": "*",
    "fastify": "^5.12.8",
    "jose": "^6.2.18",
    "postgres": "^4.1.1",
    "zod": "^4.6.7"
  }
}
