# Copy to .env for local development. Never commit real secrets.
PORT=3001
HOST=127.0.0.1
DATABASE_URL=file:./data/switchyard.sqlite

# Will be required once integration token storage lands (used to encrypt tokens at rest).
# SWITCHYARD_ENCRYPTION_KEY=

# Environment: development | test | production
NODE_ENV=development

# Open registration (true/false). Set to false once your accounts exist.
ALLOW_REGISTRATION=true

# Session cookie "Secure" flag. Defaults to true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=true

# Comma-separated origins allowed to call state-changing routes (checked against the Origin header).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Max register/login attempts per minute per IP (0 disables rate limiting).
AUTH_RATE_LIMIT_MAX=10

# Comma-separated proxies whose X-Forwarded-For header is trusted (the web app's proxy).
# When the API runs in a separate container, this MUST include the address/CIDR of the Nitro (web)
# host, e.g. TRUST_PROXY=127.0.0.1,::1,172.18.0.0/16. Otherwise the per-IP rate limit sees the
# proxy's IP for every client.
TRUST_PROXY=127.0.0.1,::1

# Production checklist: ALLOW_REGISTRATION=false once accounts exist, ALLOWED_ORIGINS set to the
# public web origin, COOKIE_SECURE=true (default in production) behind HTTPS.
