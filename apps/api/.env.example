# Copy to .env for local development (or run `npm run db:env` from the repo root, which fills it
# from the local Supabase stack). Never commit real secrets.
PORT=3001
HOST=127.0.0.1

# Environment: development | test | production
NODE_ENV=development

# Postgres connection string (REQUIRED). The value below is the Supabase CLI's public local default
# (`npm run db:start`): it only works against the local stack, never use it in production.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# TLS for the Postgres connection: require | disable. Defaults to `require` in production and
# `disable` otherwise. In production `disable` is only accepted for a loopback DB host.
# DATABASE_SSL=disable

# Supabase project URL (REQUIRED). Access tokens are verified locally against its JWKS
# (<SUPABASE_URL>/auth/v1/.well-known/jwks.json): no secret key is needed by the API.
SUPABASE_URL=http://127.0.0.1:54321

# Encryption key for integration tokens at rest (REQUIRED): 32 random bytes, base64-encoded.
# `npm run db:env` generates one if missing; otherwise use `openssl rand -base64 32`.
# Losing or changing it makes every stored token unrecoverable. Never commit it.
SWITCHYARD_ENCRYPTION_KEY=

# Comma-separated origins allowed to call state-changing routes (checked against the Origin header).
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Comma-separated proxies whose X-Forwarded-For header is trusted (the web app's proxy).
# When the API runs in a separate container, this MUST include the address/CIDR of the Nitro (web)
# host, e.g. TRUST_PROXY=127.0.0.1,::1,172.18.0.0/16.
TRUST_PROXY=127.0.0.1,::1

# Production checklist: SUPABASE_URL (https only) and DATABASE_URL (DATABASE_SSL=require) pointing to your hosted project, ALLOWED_ORIGINS
# set to the public web origin, API served behind HTTPS.
