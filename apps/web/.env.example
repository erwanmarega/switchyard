# Supabase project URL and publishable key, read by the Nitro server only (private runtime config):
# the browser never talks to Supabase and never receives these values. NEVER put the secret /
# service-role key in this app.
# For local development run `npm run db:env` (repo root) to fill these from the local stack.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_KEY=your-publishable-key
# `SUPABASE_URL` / `SUPABASE_KEY` are only read in development. Production builds use the runtime
# variables NUXT_SUPABASE_URL / NUXT_SUPABASE_KEY.

# Base URL of the Switchyard API, used by the server-side /api proxy (default: http://127.0.0.1:3001)
NUXT_API_BASE=http://127.0.0.1:3001

# Number of trusted reverse proxies between clients and this server (integer >= 0, default 0).
# 0: X-Forwarded-For is ignored (clients reach Nitro directly). N: the client IP is the N-th
# X-Forwarded-For entry from the right, i.e. the address appended by your outermost trusted proxy;
# left-most entries are client-controlled and never used. Replaces the old NUXT_TRUST_FRONT_PROXY.
# NUXT_TRUSTED_PROXY_HOPS=1

# Public origin of the app (scheme + host [+ port], no path). Set it behind a TLS-terminating proxy
# that does not forward the original host/proto: it is used for the same-origin check on
# /auth/* and /api and for the e-mail confirmation link. Add <origin>/auth/callback to the
# redirect URLs allowed in Supabase. Empty: the request URL is used.
# NUXT_PUBLIC_ORIGIN=https://switchyard.example.com
#
# If the API runs in a separate container, the API's TRUST_PROXY (apps/api/.env) must include this
# server's address, otherwise every request is seen under the proxy's IP.
