# Base URL of the Switchyard API, used by the server-side /api proxy (default: http://127.0.0.1:3001)
NUXT_API_BASE=http://127.0.0.1:3001

# Set to true ONLY when a trusted reverse proxy sits in front of this server and sets
# X-Forwarded-For (the left-most entry is then used as the client IP for the API's rate limiter).
# Leave false when clients reach this server directly: the header would be spoofable.
# NUXT_TRUST_FRONT_PROXY=false
#
# If the API runs in a separate container, the API's TRUST_PROXY (apps/api/.env) must include this
# server's address, otherwise every request is rate limited under the proxy's IP.
